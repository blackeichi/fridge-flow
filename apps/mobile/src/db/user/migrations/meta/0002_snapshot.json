        },
        "inventory_batches_unit_check": {
          "name": "inventory_batches_unit_check",
          "value": "\"inventory_batches\".\"unit\" IN ('g','kg','ml','L','개','팩','봉','병','캔')"
        },
        "inventory_batches_quantity_check": {
          "name": "inventory_batches_quantity_check",
          "value": "(\"inventory_batches\".\"quantity_known\" = 0 AND \"inventory_batches\".\"amount\" IS NULL) OR (\"inventory_batches\".\"quantity_known\" = 1 AND \"inventory_batches\".\"amount\" IS NOT NULL AND length(\"inventory_batches\".\"amount\") BETWEEN 1 AND 16 AND \"inventory_batches\".\"amount\" NOT GLOB '*[^0-9.]*' AND \"inventory_batches\".\"amount\" GLOB '[0-9]*' AND length(\"inventory_batches\".\"amount\") - length(replace(\"inventory_batches\".\"amount\", '.', '')) <= 1 AND substr(\"inventory_batches\".\"amount\", -1) <> '.' AND CAST(\"inventory_batches\".\"amount\" AS REAL) >= 0)"
        },
        "inventory_batches_status_check": {
          "name": "inventory_batches_status_check",
          "value": "\"inventory_batches\".\"status\" IN ('available','exhausted','discarded','deleted')"
        },
        "inventory_batches_exhausted_check": {
          "name": "inventory_batches_exhausted_check",
          "value": "\"inventory_batches\".\"status\" <> 'exhausted' OR (\"inventory_batches\".\"quantity_known\" = 1 AND CAST(\"inventory_batches\".\"amount\" AS REAL) = 0)"
        },
        "inventory_batches_available_check": {
          "name": "inventory_batches_available_check",
          "value": "\"inventory_batches\".\"status\" <> 'available' OR \"inventory_batches\".\"quantity_known\" = 0 OR CAST(\"inventory_batches\".\"amount\" AS REAL) > 0"
        }
      }
