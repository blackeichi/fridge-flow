# Public URL of the future Netlify AI gateway. Never put secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_AI_BASE_URL=https://example.netlify.app/api/ai

# Web OAuth client ID used as the audience of Google ID tokens. This ID is public,
# but the matching Android OAuth client must still be configured with the app
# package name and each development/release signing certificate SHA-1.
EXPO_PUBLIC_GOOGLE_SERVER_CLIENT_ID=000000000000-example.apps.googleusercontent.com
